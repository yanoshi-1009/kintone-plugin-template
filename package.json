{
  "name": "kintone-plugin-master",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.22.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "init": "node ./scripts/init.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "plugin:pack:dev": "cli-kintone plugin pack --input ./manifest.json --output ./dist/plugin.zip --private-key ./private.ppk",
    "plugin:pack:prod": "cli-kintone plugin pack --input ./manifest.prod.json --output ./dist/plugin.zip --private-key ./private.ppk",
    "typecheck": "tsc --noEmit && tsc -p scripts --noEmit",
    "build:dev": "pnpm run typecheck && pnpm run plugin:pack:dev && node ./scripts/esbuild/build.ts --mode=development",
    "build:prod": "pnpm run typecheck && node ./scripts/esbuild/build.ts --mode=production && pnpm run plugin:pack:prod",
    "upload": "cli-kintone plugin upload --input ./dist/plugin.zip --watch"
  },
  "dependencies": {
    "@kintone/rest-api-client": "6.6.1",
    "dayjs": "1.11.23",
    "i18next": "27.1.5",
    "kintone-ui-component": "1.26.0"
  },
  "devDependencies": {
    "@cybozu/eslint-config": "26.2.0",
    "@kintone/cli": "1.22.6",
    "@kintone/dts-gen": "9.0.9",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
